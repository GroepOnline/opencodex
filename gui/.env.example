# Optional PostHog project key. When unset, the GUI never loads posthog-js.
# VITE_POSTHOG_KEY=phc_xxx
# Optional host override (defaults to the EU cloud).
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Optional Sentry. When unset, the GUI does not call Sentry.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=

# Optional Datadog browser logs. This is a public client token, not an API key.
# VITE_DATADOG_CLIENT_TOKEN=
# VITE_DATADOG_SITE=datadoghq.eu

# Optional ClickHouse for local dashboard events. http loopback only, no userinfo,
# no password (a Vite value would ship inside the bundle). Authenticated
# ClickHouse is configured on the proxy with OCX_CLICKHOUSE_PASSWORD_FILE.
# VITE_CLICKHOUSE_URL=http://127.0.0.1:8123
