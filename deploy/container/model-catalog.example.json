{
  "port": 10100,
  "defaultProvider": "example-openai",
  "providers": {
    "example-openai": {
      "adapter": "openai-chat",
      "baseUrl": "https://api.example.com/v1",
      "authMode": "key",
      "apiKey": "$EXAMPLE_OPENAI_API_KEY",
      "liveModels": false,
      "contextWindow": 128000,
      "defaultModel": "example-chat",
      "models": ["example-chat"],
      "selectedModels": ["example-chat"]
    }
  }
}
