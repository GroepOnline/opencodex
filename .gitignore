node_modules/
dist/
.env
*.log
.DS_Store

# Maintainer-only planning notes. `devlog` is a private submodule
# (GroepOnline/opencodex-internal) pinned by gitlink; its contents are never
# tracked here. Commit inside the submodule, then bump the pointer separately.
devlog/

# Scratch space. Security working notes — unreleased findings, draft advisories,
# exploit reasoning, pre-disclosure patch plans — belong here or in a
# `mktemp -d` path, and nowhere else. Not devlog/, not a private repo. See the
# "Security working notes" section of AGENTS.md.
.tmp/
.opencode/

# Local agent/session artifacts
# These are per-machine agent state (goalplans, ledgers, evidence scratch).
# They are never part of the product and must not be committed, not even with
# `git add -f` — see tests/repo-hygiene.test.ts, which fails if any path here
# becomes tracked again.
.codexclaw/
**/.codexclaw/
.codex/
**/.codex/
.pi/
**/.pi/
.omo/
**/.omo/
.serena/
**/.serena/
.codebase-index/
**/.codebase-index/
.cursor/hooks/state/

# Test-generated artifacts
tests/.tmp-*/
.claude/
*.html
!.gitignore
# Compound Engineering artifacts are intentional repository output; allow HTML
# under the tracked artifact root while keeping unrelated generated HTML ignored.
!.compound-engineering/artifacts/**/*.html

# Compound Engineering checkout-local settings (tracked: config.yaml + example)
.compound-engineering/*.local.yaml

# ChefGroep standard ignores (OS / Xcode / local env / CE)
.compound-engineering/*.local.yaml

